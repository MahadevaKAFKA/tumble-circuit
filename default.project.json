{
  "name": "TumbleCircuit",
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "Shared": {
        "$path": "src/ReplicatedStorage/Shared",
        "PlaceholderIds": { "$path": "PLACEHOLDER_IDS.lua" }
      }
    },

    "ServerScriptService": {
      "$className": "ServerScriptService",
      "ServerBootstrap": { "$path": "src/ServerScriptService/ServerBootstrap.server.lua" },
      "Services": { "$path": "src/ServerScriptService/Services" },
      "Tests": { "$path": "src/Tests" }
    },

    "ServerStorage": {
      "$className": "ServerStorage",
      "ProceduralBuilders": { "$path": "src/ServerStorage/ProceduralBuilders" }
    },

    "StarterPlayer": {
      "$className": "StarterPlayer",
      "$properties": { "EnableMouseLockOption": false },
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "ClientBootstrap": { "$path": "src/StarterPlayer/StarterPlayerScripts/ClientBootstrap.client.lua" },
        "Controllers": { "$path": "src/StarterPlayer/StarterPlayerScripts/Controllers" }
      }
    },

    "Players": {
      "$className": "Players",
      "$properties": { "CharacterAutoLoads": false }
    },

    "Workspace": {
      "$className": "Workspace",
      "$properties": { "StreamingEnabled": false }
    }
  }
}
